# Template for Streamlit secrets. Copy to .streamlit/secrets.toml for local
# testing, or paste the contents into the "Secrets" panel in Streamlit
# Community Cloud (App settings → Secrets).
#
# Never commit the real secrets.toml — it is gitignored.

# Shared access code for the portal. Anyone with this code can view the app.
# Pick something long and not guessable. Rotate it after the interview.
APP_PASSWORD = "change-me-to-a-long-passphrase"

# Live Agent demo mode:
#   "true"  → serve pre-written J.D. Power briefings (zero API cost, no key required)
#   "false" → call the real Claude API
USE_MOCK_RESPONSES = "true"

# Only needed if USE_MOCK_RESPONSES = "false"
# ANTHROPIC_API_KEY = "sk-ant-api03-..."
